DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management?schema=public
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Optional until GitHub authentication is enabled in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional until GitHub repository webhooks are enabled. Use a unique 32+
# character secret and configure the same value in the GitHub App/webhook.
GITHUB_WEBHOOK_SECRET=

# Optional GitHub App installation/discovery configuration. Configure every
# value together. GITHUB_APP_PRIVATE_KEY accepts a multiline PEM or literal \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Local provider stores opaque objects under this application-owned root.
# Production requires an absolute persistent path (Docker uses /data/uploads).
FLOWPLAN_STORAGE_DRIVER=local
FLOWPLAN_STORAGE_PATH=../.flowplan-storage
