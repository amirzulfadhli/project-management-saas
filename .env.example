POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional for local GitHub webhook verification.
GITHUB_WEBHOOK_SECRET=
# Optional GitHub App installation/discovery configuration. Configure all five
# values together; encode PEM line breaks as literal \n for Compose.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3001
FRONTEND_PORT=3000
BACKEND_PORT=3001
FLOWPLAN_STORAGE_DRIVER=local
# Compose mounts its persistent upload volume at this container path.
FLOWPLAN_STORAGE_PATH=/data/uploads
